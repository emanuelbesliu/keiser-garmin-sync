# Copy to `.env` and fill in. Every value can also be set as a real environment
# variable (env wins over this file) or in a config.toml -- see config.example.toml.

# --- Keiser Metrics account (the account your M Series app signs into) ---
KEISER_EMAIL=you@example.com
KEISER_PASSWORD=your-keiser-password

# --- Garmin Connect account ---
# Preferred: seed a token once with `keiser-garmin-sync login` (MFA-safe) and
# paste the printed value here. Email/password below are a fallback and will
# NOT work if your Garmin account has MFA enabled.
GARMIN_TOKEN_BASE64=
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- optional tuning (defaults shown) ---
# LOOKBACK_DAYS=30
# SYNC_INTERVAL_MINUTES=30
# MIN_RIDE_SECONDS=60
# GRAPH_RESOLUTION=3000
# VALIDATE_UPLOADS=true
# Garmin activity type applied after upload. Keiser M Series are stationary
# bikes, so uploads are reclassified to "indoor_cycling" by default (Garmin
# ingests TCX as outdoor "cycling"). Set to "cycling" to keep Garmin's default.
# GARMIN_ACTIVITY_TYPE=indoor_cycling
# LOG_LEVEL=INFO
# HTTP_PORT=8096

# --- storage (containers default these to /data via KGS_DATA_DIR) ---
# DB_PATH=/data/keiser-garmin.db
# GARMIN_TOKENSTORE=/data/garmin-tokens
